# Crie um projeto no Supabase e use somente a URL e a chave publicável no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente no servidor. A URL separada evita depender de uma variável pública em funções.
SUPABASE_URL=

# Somente no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=

# Compatibilidade opcional com projetos que ainda usam a chave service_role legada.
SUPABASE_SERVICE_ROLE_KEY=

# Número que receberá os pedidos, apenas dígitos com DDI e DDD.
NEXT_PUBLIC_WHATSAPP_NUMBER=5599999999999
